# Caddy v2 production config. Copy to /etc/caddy/Caddyfile and set the domain.
#
#   sudo cp Caddyfile.example /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy terminates TLS and obtains/renews the certificate itself — there is no nginx and
# no certbot in this stack. For that to work the domain's A/AAAA record must already
# point here and BOTH :80 and :443 must be open: :80 carries the ACME challenge and the
# HTTP->HTTPS redirect Caddy installs automatically.
#
# Rate limiting is NOT here — Caddy has no built-in limit_req. It lives in
# server/index.mjs, which is the better layer for it anyway since only that layer can
# tell the expensive AI proxies apart from ordinary asset requests.

{
	# Delivery address for expiry / renewal-failure notices. Set this — without it a
	# failing renewal is silent until the cert actually expires.
	email ops@example.com

	servers {
		# An AI customise pass can hold a request open for well over a minute. These are
		# deliberately generous; trimming them to "normal" web values will cut off
		# in-flight passes and bill the tokens for nothing.
		timeouts {
			read_header 10s
			idle 5m
		}
	}
}

editor.example.com {
	encode zstd gzip

	log {
		output file /var/log/caddy/vs-svg-editor.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}

	header {
		# HSTS. Add `preload` and submit to hstspreload.org only once you are certain
		# every subdomain is HTTPS-only — it is very hard to undo.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

		# Caddy sets this by default; drop it.
		-Server
	}

	# --- Content-Security-Policy ---------------------------------------------------
	#
	# This matters more than usual here: editor-canvas.tsx renders imported SVG through
	# dangerouslySetInnerHTML. svg-utils.ts sanitises it with DOMPurify on the SVG
	# profile first, which is a real sanitiser rather than the pair of regexes that used
	# to stand there — but it runs in the same browser it is protecting, so the CSP is
	# still the layer that holds if a bypass is found in it.
	#
	# ENFORCED, not Report-Only. It shipped as Report-Only while the policy was unproven,
	# which meant it protected nothing; a policy nobody ever promotes is a comment. If a
	# violation does break something, the browser console names the exact directive —
	# widen that one directive rather than reverting the header to Report-Only.
	#
	# To re-verify after a change: load the editor, import an SVG, run a full customise
	# pass, export the file, and check the console for violation reports.
	#
	# 'unsafe-inline' in script-src is the weakest part and the first thing to try
	# removing — Expo's SSR output may or may not inline a hydration script depending on
	# the export. Test with it removed before assuming it's needed.
	#
	# frame-ancestors 'none' assumes the editor is NOT embedded. If it is launched in an
	# iframe from vectorstock, change it to that origin and drop X-Frame-Options above,
	# or the editor will render as a blank frame.
	# The three paddle.com sources are what the dev rail's Buy button needs: Paddle.js is
	# fetched from cdn.paddle.com, talks to api/checkout hosts under paddle.com, and draws
	# the overlay in an iframe from buy.paddle.com (sandbox-buy.paddle.com in sandbox).
	# Miss any one and the button fails in a way that looks like a Paddle outage rather
	# than a policy: the script 404s, or the overlay opens blank. Drop all three if the
	# billing button is removed — they are only here for it.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.paddle.com; connect-src 'self' https://*.paddle.com; frame-src https://*.paddle.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# --- Blocked in production -------------------------------------------------------
	#
	# /samples/* — public/samples/*.svg are copied verbatim into dist/client by the
	# export, so without this they are freely downloadable artwork with no app involved.
	# Blocked HERE ONLY — delete this block and the artwork is public immediately, with
	# nothing behind it.
	#
	# The three /api routes below only ever backed the dev rail, and Expo Router exports
	# every +api.ts regardless of the build's UI flags — so a production export ships them
	# live unless something says otherwise. /api/review/list is the one that matters most:
	# it returns every asset's edit_uuid, and that uuid is the capability the whole
	# /<uuid> flow rests on.
	#
	# They are ALSO 404'd in server/index.mjs unless DEV_API_ROUTES is set, so neither
	# layer is load-bearing alone. A deployment that genuinely wants the dev rail has to
	# remove this block AND set that variable — two deliberate acts.
	handle /samples/* {
		respond 404
	}
	handle /api/download* {
		respond 404
	}
	handle /api/review/list* {
		respond 404
	}
	handle /api/review/test* {
		respond 404
	}

	# --- Upstream ---------------------------------------------------------------------
	#
	# server/index.mjs serves dist/client itself (with correct immutable caching on the
	# hashed /_expo assets), so Caddy proxies everything rather than splitting static and
	# dynamic. One place owns the cache policy.
	#
	# Caddy already forwards X-Forwarded-For / X-Forwarded-Proto and preserves Host, and
	# the app trusts those only from loopback — so there is no proxy_set_header block to
	# write, and a spoofed X-Forwarded-For cannot dodge the rate limiter.
	handle {
		reverse_proxy 127.0.0.1:8081 {
			health_uri /health
			health_interval 10s
			health_timeout 3s

			# Long enough for an AI pass to finish. See the timeouts note above.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# /api/claude carries base64 PNG renders of the canvas to the vision model, so bodies
	# run to a few MB. Generous, but not unbounded.
	request_body {
		max_size 10MB
	}
}
